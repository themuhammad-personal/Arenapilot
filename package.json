{
  "name": "arenapilot",
  "private": true,
  "type": "module",
  "version": "3.0.0",
  "description": "ArenaPilot — an independent Android client for arena.ai Direct Chat with a built-in agent engine.",
  "scripts": {
    "test": "npm run test:template && npm run test:engine && npm run test:models",
    "test:template": "node --test scripts/*.test.mjs",
    "test:engine": "node --test android/app/src/test/js/*.test.mjs",
    "test:models": "node --test models/*.test.mjs",
    "test:harness": "node tools/harness/run.mjs",
    "test:harness:arena": "node tools/harness/arena.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "android:assemble:release": "cd android && ./gradlew assembleRelease",
    "android:stage-engine": "rm -rf android/app/src/main/assets/bds && mkdir -p android/app/src/main/assets && cp -r android/app/src/main/bds-assets/bds android/app/src/main/assets/bds",
    "android:stage-models": "mkdir -p android/app/src/main/assets/models && cp models.json android/app/src/main/assets/models/models.json",
    "models:refresh": "node scripts/fetch-models.mjs",
    "models:check": "node scripts/fetch-models.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@sparticuz/chromium": "^131.0.1",
    "acorn": "^8.18.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^15.15.0",
    "js-yaml": "^4.3.2",
    "prettier": "^3.4.0",
    "puppeteer-core": "^23.11.1"
  }
}
